{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".."
  },
  "include": [
    "../**/*.ts",
    "../**/*.vue",
    "./**/*.d.ts"
  ]
}
