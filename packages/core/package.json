{
  "name": "ripide-api",
  "type": "module",
  "version": "0.7.1",
  "description": "AST refactor engine for AI coding agents. Deterministic rename, move, find-usages, and tailwind/CSS class migration across TypeScript. Framework adapters loaded via ripide-<framework> packages.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripide.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripide/issues"
  },
  "keywords": [
    "ast",
    "refactor",
    "rename",
    "codemod",
    "typescript",
    "tailwind",
    "ripgrep",
    "ai-agent",
    "claude-code",
    "cursor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "hookable": "^6.1.2",
    "html-entities": "^2.6.0",
    "ignore": "^7.0.12",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.153.0",
    "oxc-walker": "^1.1.1",
    "picomatch": "^4.0.7",
    "std-env": "^4.3.0",
    "typescript-native": "npm:typescript@7.1.0-dev.20260905.1"
  }
}
