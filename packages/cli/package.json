{
  "name": "@ripast/cli",
  "type": "module",
  "version": "0.4.0",
  "description": "CLI for ripast. Deterministic AST refactors (rename, move, find-usages, tailwind/CSS class migration) for TypeScript and frontend frameworks. Auto-installs framework adapters as needed.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripast.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripast/issues"
  },
  "keywords": [
    "ripast",
    "cli",
    "ast",
    "refactor",
    "rename",
    "codemod"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    }
  },
  "main": "./dist/cli.mjs",
  "types": "./dist/cli.d.ts",
  "bin": {
    "ripast": "./bin/ripast.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub"
  },
  "dependencies": {
    "@ripast/core": "workspace:*",
    "citty": "^0.2.2",
    "std-env": "^4.3.0"
  }
}
