{
  "name": "ripide",
  "type": "module",
  "version": "0.8.0",
  "description": "CLI for RipIDE. Deterministic AST refactors (rename, move, find-usages, tailwind/CSS class migration) for TypeScript and frontend frameworks. Auto-installs framework adapters as needed.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripide.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripide/issues"
  },
  "keywords": [
    "ripide",
    "cli",
    "ast",
    "refactor",
    "rename",
    "codemod"
  ],
  "imports": {
    "#test-worker": "./dist/test-worker.mjs"
  },
  "exports": {
    "./check": {
      "types": "./dist/check.d.mts",
      "import": "./dist/check.mjs"
    },
    ".": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.mts",
      "import": "./dist/presentation/index.mjs"
    }
  },
  "main": "./dist/cli.mjs",
  "types": "./dist/cli.d.mts",
  "bin": {
    "ripide": "./bin/ripide.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub"
  },
  "dependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "citty": "^0.2.2",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ripide-api": "workspace:*",
    "std-env": "^4.3.0",
    "vitest": "5.0.3"
  }
}
