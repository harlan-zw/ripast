{
  "name": "@ripast/vue",
  "type": "module",
  "version": "0.4.0",
  "description": "Vue (and Nuxt) framework adapter for ripast. Provides Volar/Vue Language Service-backed rename, move, and template rewriting for .vue SFCs.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripast.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripast/issues"
  },
  "keywords": [
    "ripast",
    "vue",
    "nuxt",
    "volar",
    "ast",
    "refactor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub"
  },
  "peerDependencies": {
    "@ripast/core": "workspace:*"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@volar/language-service": "^2.4.28",
    "@volar/typescript": "^2.4.28",
    "@vue/language-core": "^3.3.11",
    "@vue/language-service": "^3.3.11",
    "volar-service-typescript": "^0.0.71",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@ripast/core": "workspace:*"
  }
}
