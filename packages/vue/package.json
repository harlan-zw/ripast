{
  "name": "ripide-vue",
  "type": "module",
  "version": "0.6.1",
  "description": "Vue (and Nuxt) framework adapter for ripide. Provides Volar/Vue Language Service-backed rename, move, and template rewriting for .vue SFCs.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripide.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripide/issues"
  },
  "keywords": [
    "ripide",
    "vue",
    "nuxt",
    "volar",
    "ast",
    "refactor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub"
  },
  "peerDependencies": {
    "ripide-api": "workspace:*"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@volar/language-service": "^2.4.28",
    "@volar/typescript": "^2.4.28",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/language-core": "^3.3.12",
    "@vue/language-service": "^3.3.12",
    "oxc-parser": "^0.153.0",
    "oxc-walker": "^1.1.1",
    "picomatch": "^4.0.7",
    "volar-service-typescript": "^0.0.71",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "ripide-api": "workspace:*"
  }
}
