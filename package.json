{
  "name": "ripast-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "homepage": "https://github.com/harlan-zw/ripast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/ripast.git"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/ripast/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "bench": "tsx bench/bench.ts",
    "dev:prepare": "pnpm -r --filter './packages/*' run dev:prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:package": "node --experimental-strip-types scripts/smoke-package.ts",
    "release": "pnpm build && bumpp --recursive && pnpm -r --filter './packages/*' publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@ripast/cli": "workspace:*",
    "@ripast/core": "workspace:*",
    "@ripast/vue": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "bumpp": "^12.3.0",
    "citty": "^0.2.2",
    "eslint": "^10.12.0",
    "obuild": "^0.4.43",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.3",
    "vscode-uri": "^3.2.0"
  }
}
